DATABASE_URL=          # Neon connection string
ADMIN_PASSWORD=        # password for /admin
AI_ENABLED=false       # seeds the settings table on first run; AI features are optional
OLLAMA_API_KEY=        # Bearer token from ollama.com/settings/keys; leave blank to disable AI
OLLAMA_MODEL=gemma4:31b  # verify available models via GET https://ollama.com/v1/models
